{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  schedule: [
    '* 0-3 * * 1',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  automerge: false,
  ignoreUnstable: true,
  minimumReleaseAge: '3 days',
  separateMajorMinor: true,
  labels: [
    'dependencies',
  ],
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
    },
    {
      groupName: 'Kotlin and KSP',
      matchPackageNames: [
        '/^org\\.jetbrains\\.kotlin/',
        '/^com\\.google\\.devtools\\.ksp/',
      ],
    },
    {
      groupName: 'Android Gradle Plugin and Gradle',
      matchPackageNames: [
        '/^com\\.android\\.application/',
        '/^com\\.android\\.tools\\.build/',
      ],
    },
    {
      groupName: 'Android Gradle Plugin and Gradle',
      matchManagers: [
        'gradle-wrapper',
      ],
    },
    {
      matchPackageNames: [
        'eclipse-temurin',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'java-jdk',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      groupName: 'AndroidX',
      matchPackageNames: [
        '/^androidx\\./',
      ],
    },
  ],
}
